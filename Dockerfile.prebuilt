# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.prebuilt
#
# Packages the ALREADY-COMPILED WRF-Chem into a container image.
# Nothing is (re)compiled here.  All binaries come from the staging directory
# produced by  gather_runtime.sh  (run once on Perlmutter).
#
# Build context layout expected (produced by gather_runtime.sh):
#   docker_context/
#     wrf/
#       main/        ← wrf.exe, real.exe, ndown.exe
#       run/         ← all WRF data / chemistry table files
#     ftorch_libs/   ← libftorch.so*  (from ~/opt/ftorch/lib64)
#     libtorch_libs/ ← libtorch*.so*  (from libtorch-cpu/lib)
#     runtime_libs/  ← any extra .so deps found by ldd not in the base image
#
# Build command (on your Docker host, from the directory that contains
# this file and the docker_context/ folder):
#
#   docker build \
#     -f Dockerfile.prebuilt \
#     -t wrf-chem-prebuilt \
#     docker_context/
#
# ─────────────────────────────────────────────────────────────────────────────
FROM benjaminkirk/ncar-derecho-wrf:latest
SHELL ["/bin/bash", "-c"]

# ── Copy FTorch shared libraries (not in the base image) ─────────────────────
COPY ftorch_libs/   /opt/ftorch/lib64/

# ── Copy LibTorch shared libraries (not in the base image) ───────────────────
COPY libtorch_libs/ /opt/libtorch/lib/

# ── Copy any extra runtime .so files gathered by ldd ─────────────────────────
# (NetCDF/HDF5/MPI from Perlmutter's Cray stack that differ from the base)
COPY runtime_libs/  /opt/runtime_libs/

# ── Copy the pre-compiled WRF tree ───────────────────────────────────────────
# wrf/main/ → executables
# wrf/run/  → data tables, chemistry inputs, namelists
COPY wrf/ /container/WRF/

# ── Wire everything up — mirrors the style of the compile-based Dockerfile ───
RUN source /container/config_env.sh && \
    mkdir -p /container/wrf-chem-4.4.2 && \
    cp /container/WRF/main/wrf.exe  /container/wrf-chem-4.4.2/ && \
    cp /container/WRF/main/real.exe /container/wrf-chem-4.4.2/ && \
    chmod -R a+rx /container

# ── Runtime library search path ───────────────────────────────────────────────
# FTorch and LibTorch take priority; bundled runtime_libs fill any Cray gaps;
# the base image's libs handle the rest.
ENV LD_LIBRARY_PATH="/opt/ftorch/lib64:/opt/libtorch/lib:/opt/runtime_libs:${LD_LIBRARY_PATH:-}"

CMD ["/bin/bash"]
